# =============================================================================
# CONSULVOLT - Plataforma Universal de Recrutamento Multi-Concurso
# Copiar para .env.local (desenvolvimento) e colar no fornecedor de alojamento.
# NUNCA fazer commit do .env.local - só deste ficheiro de exemplo.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE  (Project Settings > API)
# -----------------------------------------------------------------------------
# URL do projecto, ex.: https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública "anon" - vai para o browser, só permite INSERIR (ver RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role" - SÓ no servidor. Ignora o RLS. Nunca prefixar com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# GOOGLE DRIVE
# Há duas vias, e o sistema escolhe sozinho conforme o que estiver preenchido.
#
# VIA A - conta pessoal (Gmail / Google One): OAuth2, os ficheiros ficam teus.
#         É a única possível sem Google Workspace, porque as contas de serviço
#         não têm quota e não podem ser donas de ficheiros.
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# -----------------------------------------------------------------------------
# VIA B - Google Workspace com Drive Partilhada: conta de serviço.
#         Se preencheres as duas vias, ganha a Via A.
# -----------------------------------------------------------------------------
# Conteúdo INTEIRO do ficheiro JSON da Service Account, numa única linha.
# Na Vercel cola-se o JSON tal e qual. Em .env.local envolver em plicas simples:
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...", ...}'
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID da pasta-mãe no Drive (o bocado depois de /folders/ no endereço da pasta).
# Esta pasta TEM de estar partilhada com o email da Service Account como Editor.
# Opcional. Com o âmbito drive.file a aplicação não vê pastas criadas à mão:
# deixa vazio e a pasta é criada na raiz do teu disco. Só preencher em Drives Partilhadas.
GOOGLE_DRIVE_FOLDER_ID=
# Se a pasta-mãe estiver numa Shared Drive (Drive Partilhada), pôr "true"
GOOGLE_DRIVE_SHARED_DRIVE=false

# -----------------------------------------------------------------------------
# EMAIL  (Gmail + palavra-passe de aplicação - 2FA tem de estar activo)
# -----------------------------------------------------------------------------
# Conta que ENVIA. Usar a conta Gmail real; o SMTP do consulvolt.pt não autentica.
GMAIL_USER=hdsgeral@gmail.com
# Palavra-passe de aplicação de 16 caracteres (com ou sem espaços)
GMAIL_APP_PASSWORD=
# Nome que aparece ao candidato como remetente
EMAIL_REMETENTE_NOME=Consulvolt - Recrutamento
# Caixa de RH que recebe o aviso de cada candidatura (pode ter várias, separadas por vírgula)
RH_EMAIL=recrutamento@consulvolt.pt

# -----------------------------------------------------------------------------
# PAINEL ADMIN
# -----------------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASS=Consulvolt@2026
# Segredo para assinar o cookie de sessão do painel.
# Gerar com:  openssl rand -base64 32
ADMIN_SESSION_SECRET=

# -----------------------------------------------------------------------------
# APLICAÇÃO
# -----------------------------------------------------------------------------
# Endereço público do site (sem barra no fim). Usado nos links dos emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Segredo partilhado entre a Server Action e a rota /api/arquivar
CRON_SECRET=

# -----------------------------------------------------------------------------
# ANÁLISE DAS CANDIDATURAS (ranking)
#
# A leitura dos documentos tem três camadas:
#   1. OCR do Google Drive        - já funciona com as credenciais acima, grátis
#   2. Extractor determinístico   - TypeScript puro, sem chave, corre sempre
#   3. Modelo de linguagem        - interpreta o texto do OCR (opcional)
#
# A camada 3 é o que faz a diferença entre 37 e 100 pontos possíveis: sem ela,
# só pontuam os critérios que vêm do formulário e os que o dicionário apanha.
#
# GEMINI (recomendado, é a Google que já usas para o Drive):
#   Tira a chave em https://aistudio.google.com/apikey
#   Atenção: o plano Google AI Ultra NÃO paga esta API. A chave tem um plano
#   gratuito próprio, que chega para algumas centenas de candidaturas.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
# Opcional. Por omissão o sistema tenta gemini-3.5-flash e, se não existir,
# percorre sozinho os modelos seguintes do catálogo.
GEMINI_MODEL=

# Alternativa à de cima. Se as duas estiverem preenchidas, ganha o Gemini.
ANTHROPIC_API_KEY=
